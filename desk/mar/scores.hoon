/-  *hits
=,  format
|_  update=(list [app score])
++  grab
  |%
  ++  noun  (list ,[app score])
  --
++  grow
  |%
  ++  noun  update
  ++  json
    %-  frond:enjs
    :-  'scores'
    :-  %a
    %+  turn
      update
    |=  [[=ship =desk] =score]
    %-  pairs:enjs
    :~  ['app' [%s (scot %tas desk)]]
        ['source' [%s (scot %p ship)]]
        ['score' (numb:enjs score)]
    ==
  --
++  grad  %noun
--
